<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48, matching the reference implementation (OneMore) and, more importantly, matching
         what is already on every Windows 10/11 machine. A student installing a study tool should
         not have to install a runtime first. -->
    <TargetFramework>net48</TargetFramework>
    <!-- AnyCPU, deliberately. A COM add-in is loaded INTO a host process, so an x64-only assembly
         simply cannot load on an ARM64 machine - which is the target hardware, since Snapdragon
         Surfaces are exactly where lecture notes get taken with a pen. AnyCPU JITs to whatever the
         host is: x64 on a desktop, native ARM64 on a Surface, no emulation and no second build.
         Both vendored interop assemblies are MSIL, so nothing else pins us to an architecture. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RecallTape.OneNote</AssemblyName>
    <RootNamespace>RecallTape.OneNote</RootNamespace>
    <ComVisible>false</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.0.1</Version>
    <Company>EWC3 Labs</Company>
    <Product>RecallTape</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- net48 reference assemblies without requiring Visual Studio on the build box. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real Extensibility PIA, embedded.

         EmbedInteropTypes=True compiles the interface definitions in, so there is NO runtime
         dependency and nothing to redistribute - only the build box needs the file, and it ships
         with .NET Framework in the GAC.

         WHY not hand-declare it: we tried. Correct IID (byte-verified against MSADDNDR.OLB), dual
         interface, methods in typelib order with explicit DispIds, and even [TypeIdentifier] for COM
         type equivalence. OneNote still constructed the class in the surrogate and never called
         OnConnection. The PIA is the only thing that makes the add-in contract work.

         Vendored in lib/ so the build is hermetic - see lib/README.md. Resolving from the GAC worked
         on exactly one machine, and only because OneMore's installer had put it there. -->
    <Reference Include="Extensibility">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\Extensibility.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>

    <!-- The OneNote PIA, embedded. Same reasoning as Extensibility above, plus: `dynamic` cannot
         be used against the OneNote Application at all. The C# dynamic COM binder calls
         IDispatch::GetTypeInfo to enumerate members first, and OneNote returns E_FAIL to that from
         inside the surrogate, so the call fails before reaching any OneNote method. The typed
         interface binds through the vtable instead. -->
    <!-- NOT embedded, and copied local: IApplication in this PIA is not marked ComImport, so the
         compiler refuses to embed it (CS1756). OneMore references it the same way and ships the DLL
         beside the add-in. Vendored in lib/ - see lib/README.md. -->
    <Reference Include="Microsoft.Office.Interop.OneNote">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\Microsoft.Office.Interop.OneNote.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>True</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
