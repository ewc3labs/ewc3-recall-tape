<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinExe, not Exe: a console window flashing on screen every time someone clicks a tape strip
         would be worse than no reveal at all. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RecallTape.ProtocolHandler</AssemblyName>
    <RootNamespace>RecallTape.ProtocolHandler</RootNamespace>
    <Version>0.0.1</Version>
    <Company>EWC3 Labs</Company>
    <Product>RecallTape</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
